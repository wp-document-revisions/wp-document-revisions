#!/usr/bin/env node
/**
 * Builds readme.txt (the WordPress.org plugin readme) from docs/*.md.
 *
 * Run from the repository root: script/build-readme
 * Never edit readme.txt by hand; edit docs/ and rerun this.
 */

const fs = require( 'fs' );
const path = require( 'path' );

// The docs that go into readme.txt, in order, after the README. Docs missing
// from this list stay on the docs site only, so a new doc has to be added
// here to ship on WordPress.org.
//
// WordPress.org gives Installation, Frequently Asked Questions, Screenshots
// and Changelog their own tabs and folds every other section into
// Description, which it cuts off after 2,500 words. So developer docs
// (actions, filters, shortcodes, block editor, data structure) and long
// how-tos (notifications, translations, useful plugins and tools) stay on the
// docs site, where the README links to them.
const sections = [ 'features', 'frequently-asked-questions', 'installation', 'links', 'screenshots' ];
const descriptionWordLimit = 2500;
const docsUrl = 'https://wp-document-revisions.github.io/wp-document-revisions/';
const read = ( file ) => fs.readFileSync( file, 'utf8' );

/**
 * Converts fenced code blocks to indented ones and Markdown headings to
 * readme.txt headings.
 *
 * WordPress.org's readme parser doesn't understand fenced code blocks: it
 * reads a backtick at the start of a line as inline code, so a fence turns
 * into an empty block followed by the code as a paragraph, where WordPress
 * curls quotes and turns `--flag` into an en dash. Indented code blocks are
 * the form it renders as <pre><code>. A fence inside a list item is indented
 * past the item's own indent, so the code stays part of the item.
 *
 * Headings are converted in the same pass so a `#` comment inside a code
 * block stays a comment.
 *
 * @param {string} text Markdown to convert.
 * @return {string} The converted text.
 */
function convertCodeAndHeadings( text ) {
	const FENCE_MARK = '\u0000';
	let fence = null;
	const lines = text.split( '\n' ).map( ( line ) => {
		if ( fence ) {
			if ( line.trim() === fence.marker ) {
				fence = null;
				return FENCE_MARK;
			}
			if ( line.trim() === '' ) {
				return '';
			}
			return ' '.repeat( fence.indent ) + line.replace( new RegExp( `^ {0,${ fence.strip }}` ), '' );
		}

		const open = line.match( /^(\s*)(```|~~~)/ );
		if ( open ) {
			const strip = open[ 1 ].length;
			const listIndent = strip === 0 ? 0 : 4 * Math.floor( ( strip + 3 ) / 4 );
			fence = { marker: open[ 2 ], strip, indent: listIndent + 4 };
			return FENCE_MARK;
		}

		return line
			.replace( /^### ?(.*?)$/, '= $1 =' )
			.replace( /^## ?(.*?)$/, '== $1 ==' )
			.replace( /^# ?(.*?)$/, '=== $1 ===' );
	} );
	if ( fence ) {
		throw new Error( 'unclosed code fence' );
	}

	// Replace each fence line, and the blank lines around it, with one blank line.
	return lines.join( '\n' ).replace( new RegExp( `\\n*(?:${ FENCE_MARK }\\n*)+`, 'g' ), '\n\n' );
}

/**
 * Builds the readme.txt contents from a repository's docs/ folder.
 *
 * @param {string} root Repository root that contains docs/.
 * @return {string} The readme.txt contents.
 */
function buildReadme( root ) {
	const docs = path.join( root, 'docs' );

	let output = read( path.join( docs, 'header.md' ) );

	// Add Description section header after the short description.
	output += '\n## Description\n';

	// Drop the title, badges and short description from the README: keep
	// everything from its second heading on. Trailing empty pieces are dropped,
	// as Ruby's String#split (which this script was ported from) does.
	const readme = read( path.join( docs, 'README.md' ) ).split( '#' );
	while ( readme.length && readme[ readme.length - 1 ] === '' ) {
		readme.pop();
	}
	output += '\n#' + readme.slice( 2 ).join( '#' );

	for ( const name of sections ) {
		const file = path.join( docs, `${ name }.md` );
		if ( ! fs.existsSync( file ) ) {
			throw new Error( `Missing docs/${ name }.md; remove it from the sections list in script/build-readme if it was deleted on purpose.` );
		}
		output += '\n\n' + read( file );
	}

	// Add the changelog, truncated to the three most recent versions.
	output += '\n\n';
	let inChangelog = false;
	let versionCount = 0;
	for ( const line of read( path.join( docs, 'changelog.md' ) ).split( '\n' ) ) {
		if ( /^## Changelog/.test( line ) ) {
			inChangelog = true;
		}
		if ( ! inChangelog ) {
			continue;
		}
		// Stop at the fourth version's heading, so the third keeps its entries.
		if ( /^### \d+\.\d+/.test( line ) && ++versionCount > 3 ) {
			output += `For complete changelog, see [GitHub](${ docsUrl }changelog/)\n`;
			break;
		}
		output += line + '\n';
	}

	output = convertCodeAndHeadings( output ).replace( /\]\(\.?\/?(.*?)\.md/g, `](${ docsUrl }$1/` );

	// The readme parser shows a link in a heading as raw Markdown.
	const linkedHeading = output.match( /^=+ .*\]\(.*=+$/m );
	if ( linkedHeading ) {
		throw new Error(
			`WordPress.org shows links in headings as raw Markdown; move the link out of: ${ linkedHeading[ 0 ] }`
		);
	}

	// Fail here rather than ship a plugin page that ends mid-sentence. The
	// readme parser counts words split on whitespace. Installation, FAQ,
	// Screenshots, Changelog and Upgrade Notice get their own tabs (FAQ and
	// Changelog get 5,000 words each); every other section counts toward
	// Description's 2,500.
	const tabbed = [ 'Installation', 'Frequently Asked Questions', 'FAQ', 'Screenshots', 'Changelog', 'Upgrade Notice' ];
	let words = 0;
	let inTab = true;
	for ( const line of output.split( '\n' ) ) {
		const section = line.match( /^== (.*) ==$/ );
		if ( section ) {
			inTab = tabbed.includes( section[ 1 ] );
		}
		if ( ! inTab ) {
			words += line.split( /\s+/ ).filter( Boolean ).length;
		}
	}
	if ( words > descriptionWordLimit ) {
		throw new Error(
			`Description is ${ words } words; WordPress.org cuts it off at ${ descriptionWordLimit }. ` +
				'Shorten a doc, or add one that has its own page on the docs site to the exclude list.'
		);
	}

	return output;
}

module.exports = { buildReadme };

if ( require.main === module ) {
	fs.writeFileSync( 'readme.txt', buildReadme( '.' ) );
}
