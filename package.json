{
  "name": "wp-document-revisions",
  "version": "4.0.0",
  "description": "Document management and version control for WordPress",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint-js": "wp-scripts lint-js src",
    "lint-js:fix": "wp-scripts lint-js src --fix",
    "type-check": "tsc -p jsconfig.json",
    "build": "npm run build:blocks && npm run build:editor && npm run build:admin",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks",
    "build:editor": "wp-scripts build src/editor-document-upload/index.js --output-path=build/editor-document-upload",
    "build:admin": "wp-scripts build src/admin/wp-document-revisions.js src/admin/wp-document-revisions-validate.js src/admin/wp-document-revisions-ai-prefill.js --output-path=build/admin",
    "start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
    "start:admin": "wp-scripts start src/admin/wp-document-revisions.js src/admin/wp-document-revisions-validate.js src/admin/wp-document-revisions-ai-prefill.js --output-path=build/admin",
    "test:e2e": "npx playwright test --config=playwright.config.mjs",
    "test:e2e:ui": "npx playwright test --config=playwright.config.mjs --ui",
    "wp-env": "wp-env"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wp-document-revisions/wp-document-revisions.git"
  },
  "keywords": [
    "wordpress",
    "documents",
    "revisions",
    "version-control"
  ],
  "author": "WP Document Revisions Contributors",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@wordpress/e2e-test-utils-playwright": "1.46.0",
    "@wordpress/env": "^11.11.0",
    "@wordpress/scripts": "^34.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "~29.7.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "jest-mock": "^30"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/js/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/admin/**/*.js",
      "src/blocks/**/*.js",
      "src/editor-document-upload/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/js/setup.js"
    ],
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/tests/js/__mocks__/styleMock.js",
      "^@wordpress/api-fetch$": "<rootDir>/tests/js/__mocks__/wordpress-api-fetch.js",
      "^@wordpress/dom-ready$": "<rootDir>/tests/js/__mocks__/wordpress-dom-ready.js"
    }
  }
}
