#!/usr/bin/env bash
# PreToolUse guard for Edit/Write/MultiEdit: denies hand edits to files that CI
# regenerates, so the change isn't silently overwritten by the next build.
#
# - readme.txt is built from docs/*.md by script/build-readme, which
#   .github/workflows/build-readme.yml runs on every push to main.
# - languages/*.pot is built by script/generate-pot via .github/workflows/pot.yml.
#
# .po/.mo files stay editable: surgical translation fixes are intended.
#
# Input: the hook JSON on stdin. Output: a "deny" decision whose reason is fed
# back to Claude, or nothing.

command -v jq >/dev/null || exit 0
file=$(jq -r '.tool_input.file_path // ""')
[ -n "$file" ] || exit 0
root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null) || exit 0
rel=${file#"$root"/}

case "$rel" in
  readme.txt)
    reason="readme.txt is generated from docs/*.md by script/build-readme (.github/workflows/build-readme.yml runs it on push to main). Edit the matching docs/ source instead; run script/build-readme only if you need to preview the result." ;;
  languages/*.pot)
    reason="$rel is generated by script/generate-pot (.github/workflows/pot.yml opens an \"Update POT file\" PR). Change the source strings in PHP/JS instead." ;;
  *) exit 0 ;;
esac

jq -n --arg reason "$reason" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: $reason
  }
}'
