#. Description of the plugin
#: wp-document-revisions.php
msgid ""
"A document management and version control plugin for WordPress that allows "
"teams of any size to collaboratively edit files and manage their workflow."
msgstr ""
"En dokument forvaltning og versjon kontroll plugin for WordPress som "
"tillater lag av hvilken som helst størrelse til å samarbeide med å redigere "
"filer og håndtere deres arbeidsstatus."

#. Author of the plugin
#: wp-document-revisions.php
msgid "Ben Balter"
msgstr "Ben Balter"

#. Author URI of the plugin
