#. Plugin Name of the plugin
#: wp-document-revisions.php
#: includes/class-wp-document-revisions-front-end.php:565
msgid "WP Document Revisions"
msgstr "Revize dokumentů WP"

#. Plugin URI of the plugin
#: wp-document-revisions.php
msgid ""
"http://ben.balter.com/2011/08/29/wp-document-revisions-document-management-"
"version-control-wordpress/"
msgstr ""
"http://ben.balter.com/2011/08/29/wp-document-revisions-document-management-"
"version-control-wordpress/"

#. Description of the plugin
#: wp-document-revisions.php
msgid ""
"A document management and version control plugin for WordPress that allows "
"teams of any size to collaboratively edit files and manage their workflow."
msgstr ""
"Plugin pro správu dokumentů a kontrolu verzí pro WordPress, který umožňuje "
"týmům jakékoli velikosti společně upravovat soubory a spravovat jejich "
"pracovní postupy."

#. Author of the plugin
#: wp-document-revisions.php
msgid "Ben Balter"
msgstr "Ben Balter"

#. Author URI of the plugin
#: wp-document-revisions.php
msgid "https://ben.balter.com"
msgstr "https://ben.balter.com"

