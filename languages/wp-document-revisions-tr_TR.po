msgstr "GUID, beklenen \"çirkin\" kalıcı bağlantı değil."

#: includes/class-wp-document-revisions-validate-structure.php:619
#: includes/class-wp-document-revisions-validate-structure.php:848
#: includes/class-wp-document-revisions-validate-structure.php:912
