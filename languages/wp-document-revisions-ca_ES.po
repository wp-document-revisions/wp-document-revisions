msgid "WP Document Revisions"
msgstr "Revisions de documents de WP"

#. Plugin URI of the plugin
#: wp-document-revisions.php
msgid ""
"http://ben.balter.com/2011/08/29/wp-document-revisions-document-management-"
"version-control-wordpress/"
msgstr ""
"http://ben.balter.com/2011/08/29/wp-document-revisions-document-management-"
"version-control-wordpress/"

#. Description of the plugin
#: wp-document-revisions.php
msgid ""
"A document management and version control plugin for WordPress that allows "
"teams of any size to collaboratively edit files and manage their workflow."
msgstr ""
"Un complement de gestió de documents i control de versions per a WordPress "
"que permet a equips de qualsevol mida editar fitxers de manera "
"col·laborativa i gestionar el seu flux de treball."

#. Author of the plugin
#: wp-document-revisions.php
msgid "Ben Balter"
msgstr "Ben Balter"

#. Author URI of the plugin
#: wp-document-revisions.php
msgid "https://ben.balter.com"
msgstr "https://ben.balter.com"

