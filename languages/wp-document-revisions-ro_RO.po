#. Description of the plugin
#: wp-document-revisions.php
msgid ""
"A document management and version control plugin for WordPress that allows "
"teams of any size to collaboratively edit files and manage their workflow."
msgstr ""
"Un plugin de gestionare a documentelor și control al versiunilor pentru "
"WordPress care permite echipelor de orice dimensiune să editeze fișiere în "
"mod colaborativ și să își gestioneze fluxul de lucru."

#. Author of the plugin
#: wp-document-revisions.php
msgid "Ben Balter"
msgstr "Ben Balter"

